<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Version>1.1.0</Version>
    <AssemblyName>Larik.Data.Sqlite</AssemblyName>
    <RootNamespace>Larik.Data.Sqlite</RootNamespace>
    <!-- One restore produces the assets for both release zips. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Larik.Data" Version="1.1.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <!-- Read straight from the open handle for exact transaction state. -->
    <PackageReference Include="SQLitePCLRaw.core" Version="2.1.13" />
  </ItemGroup>

  <!-- The test project lives under tests/; do not compile its sources into the provider. -->
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

</Project>
